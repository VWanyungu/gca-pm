# development
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# staging
STAGING_DB_HOST=
STAGING_DB_PORT=
STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_DB_NAME=

# production
PROD_DB_HOST=
PROD_DB_PORT=
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_DB_NAME=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
FORGOT_PASSWORD_TOKEN_SECRET=
TOKEN_EXPIRY=
TOKEN_EXPIRY_ABSOLUTE=
TOKEN_EXPIRY_SECONDS=

FRONTEND_URL=
BACKEND_URL=
CORS_ORIGIN=

# temporary: sending via a personal Gmail account until the company M365 mailbox is
# wired up. GMAIL_USER is the full gmail.com address, GMAIL_APP_PASSWORD is a 16-char
# App Password (Google Account -> Security -> 2-Step Verification -> App passwords),
# not the account's login password. MAIL_FROM must match GMAIL_USER.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=

PORT=
NODE_ENV=

# javamppms (MS Project parser). Leave unset locally — mppParser.ts defaults to
# http://127.0.0.1:8081. Set this in Vercel's production env vars to the deployed
# service's URL.
MPP_PARSER_URL=

# cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push-style heartbeat (e.g. an Uptime Kuma push monitor URL) pinged after the nightly
# 3am project-metrics refresh. Leave unset to skip pinging.
CRON_HEARTBEAT_URL=
