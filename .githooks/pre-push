#!/bin/sh
# Verifies backend and frontend still build before allowing a push. This is a
# validation rebuild only — Next.js embeds a random BUILD_ID and hashed static
# chunk names on every build, so output is never byte-identical even when
# nothing changed. Any diff this rebuild produces in the tracked backend/dist
# or frontend/.next/standalone is discarded afterward; if you want fresh build
# output pushed, rebuild and commit it yourself before pushing.
set -e

echo "Running backend build..."
(cd backend && npm run build)

echo "Running frontend build..."
(cd frontend && npm run build)

git checkout -- backend/dist frontend/.next/standalone
